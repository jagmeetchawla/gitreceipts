/target

# Editor / OS cruft (also covered by many global gitignores, but keep the repo
# self-contained so a fresh clone can't commit them).
.DS_Store
.idea/
*.log

# Generated reports & receipts — session artifacts, NEVER source, and they can
# carry private data. The tool writes them at the repo root when you run it here
# (`audit --format html > x.html`, `export > x.json`); keep every such file out.
# Intentional example fixtures live under docs/ and are `git add`-ed explicitly.
*.html
/*.json
*.receipt.json
qa/output/
man/
